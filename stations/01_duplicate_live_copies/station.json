{
  "name": "01_duplicate_live_copies",
  "description": "Decide which of several identical live copies is canonical.",
  "provider_profile": "deepseek",
  "model": "",
  "auto_model": false,
  "max_tokens": 4096,
  "temperature": 0.2,
  "max_input_chars": 120000,
  "batch_size": 1,
  "concurrency": 1,
  "input_globs": [
    "*.md",
    "*.json"
  ],
  "attachments": [
    "reference/*.md"
  ],
  "output_format": "md",
  "output_name": "{stem}.result.{ext}",
  "categorize_by": "verdict",
  "on_success": "outbox",
  "on_failure": "failed",
  "move_input_to": "outbox/_consumed",
  "require_execute": true,
  "cost_ceiling_usd": 1.0,
  "mode": "per_item",
  "vectorize": false,
  "max_probe_seconds": 45,
  "max_latency_seconds": 120,
  "min_context_tokens": 0,
  "demote_minutes": 120
}
